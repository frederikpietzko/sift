{
  "name": "@sift/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, framework-agnostic client for the Sift server API generated from api/openapi.yaml",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/generated && cp src/generated/schema.d.ts dist/generated/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
