# Copy to tools/e2e.env (git-ignored) and fill in real values. Sourced by tools/e2e.sh.

# Required: forwarded into the sift-local-credentials Secret.
OPENAI_API_KEY=
SIFT_MODEL_PROXY_TOKEN=

# Optional: avoid unauthenticated GitHub API rate limits when resolving the sample PR.
#GITHUB_TOKEN=

# Optional: sample pull request owner/repo#number (head must live in the base repository).
#SIFT_E2E_PR=frederikpietzko/ebfs-jpa#1

# Optional: whole-scenario budget as a Kotlin Duration string (default 20m).
#SIFT_E2E_TIMEOUT=20m

# Optional: delete the sift-e2e kind cluster in teardown.
#SIFT_E2E_DESTROY=false
