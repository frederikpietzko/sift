# Local development defaults for `tools/dev.sh`.
#
# Everything in here is intentionally committed: the values only ever reach the Compose stack,
# the local kind cluster and the Vite dev server on this machine. They are NOT secrets and must
# never be reused for a shared or production deployment. Values already present in the
# environment win, so `SERVER_PORT=8081 tools/dev.sh` works without editing this file.
#
# Real credentials (model API key, git tokens) stay out of this file; see tools/e2e.env.example
# and `python3 k8s/local/dev.py secrets` for those.

# --- Compose services (see compose.yaml) ---
export SPRING_DATASOURCE_URL="${SPRING_DATASOURCE_URL:-jdbc:postgresql://localhost:5432/sift}"
export SPRING_DATASOURCE_USERNAME="${SPRING_DATASOURCE_USERNAME:-sift}"
export SPRING_DATASOURCE_PASSWORD="${SPRING_DATASOURCE_PASSWORD:-sift}"
export SPRING_RABBITMQ_HOST="${SPRING_RABBITMQ_HOST:-localhost}"
export SPRING_RABBITMQ_PORT="${SPRING_RABBITMQ_PORT:-5672}"
export SPRING_RABBITMQ_USERNAME="${SPRING_RABBITMQ_USERNAME:-sift}"
export SPRING_RABBITMQ_PASSWORD="${SPRING_RABBITMQ_PASSWORD:-sift}"

# --- Authentication (Keycloak realm `sift`, imported from config/keycloak/sift-realm.json) ---
# Users: dev/dev and e2e/e2e. `sift-web` is a public PKCE client, so no client secret exists.
export SIFT_DEV_KEYCLOAK_URL="${SIFT_DEV_KEYCLOAK_URL:-http://localhost:8180}"
export SIFT_DEV_KEYCLOAK_REALM="${SIFT_DEV_KEYCLOAK_REALM:-sift}"
export SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI="${SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI:-$SIFT_DEV_KEYCLOAK_URL/realms/$SIFT_DEV_KEYCLOAK_REALM}"
export SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES="${SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES:-sift-server}"
export SIFT_SERVER_AUTH_CLIENT_ID="${SIFT_SERVER_AUTH_CLIENT_ID:-sift-web}"

# --- Server ---
export SIFT_SERVER_NAMESPACE="${SIFT_SERVER_NAMESPACE:-sift-dev}"
# Base64 of the 32 ASCII bytes `sift-local-dev-encryption-key-32`. Fixed on purpose so repository
# tokens stored by a previous local run stay decryptable across restarts.
export SIFT_SERVER_ENCRYPTION_KEY="${SIFT_SERVER_ENCRYPTION_KEY:-c2lmdC1sb2NhbC1kZXYtZW5jcnlwdGlvbi1rZXktMzI=}"
export SERVER_ADDRESS="${SERVER_ADDRESS:-127.0.0.1}"
export SERVER_PORT="${SERVER_PORT:-8080}"

# --- Operator (host-run against the kind cluster, see k8s/local/dev.py) ---
export SIFT_DEV_CONTEXT="${SIFT_DEV_CONTEXT:-kind-kind}"
export SIFT_OPERATOR_NAMESPACE="${SIFT_OPERATOR_NAMESPACE:-sift-dev}"
# Secret the review Jobs read for model access and the RabbitMQ password (see k8s/local/operator.yaml).
# Its contents are real credentials and stay out of this file; `tools/dev.sh` only verifies/provisions it.
export SIFT_DEV_CREDENTIALS_SECRET="${SIFT_DEV_CREDENTIALS_SECRET:-sift-local-credentials}"
# Same digest the operator defaults to; override to test a locally built review agent image.
export SIFT_REVIEW_IMAGE="${SIFT_REVIEW_IMAGE:-jbfpietzko/shift-code-review-agent@sha256:3a1b0931077c0bb2d0462c4d8ba065c1e57c8892b76169d1d80dbf6af4dd29e4}"

# --- Web (Vite dev server, proxies /api to the server) ---
export SIFT_DEV_WEB_PORT="${SIFT_DEV_WEB_PORT:-5173}"
